{
  "name": "whocares",
  "private": true,
  "type": "module",
  "description": "Who Cares: a live map of ageing tech. Static site plus optional Neon-backed API.",
  "scripts": {
    "dev": "node server/dev.mjs",
    "migrate": "node db/migrate.mjs",
    "seed": "node db/seed.mjs",
    "export": "node db/export.mjs && node scripts/build-atlas-data.mjs",
    "test": "node --test api/_lib/shape.test.mjs",
    "build:atlas": "node scripts/build-atlas-data.mjs",
    "test:atlas": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
