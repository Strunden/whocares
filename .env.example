# Neon pooled connection string. Copy this file to .env and fill it in.
# Never commit .env. The static site does not need this value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional. When set, POST and PATCH require: Authorization: Bearer <token>
WHOCARES_WRITE_TOKEN=

# Browser origin allowed to call the API. Use * or the GitHub Pages origin.
CORS_ORIGIN=*

# Local API + static server (npm run dev).
PORT=8877
